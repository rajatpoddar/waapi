# =====================================================================
#  WAPI - Self-Hosted WhatsApp API  (Baileys + FastAPI)
#  Copy this file to ".env" and adjust before running:
#      docker compose up -d
# =====================================================================

# ---------------------------------------------------------------
# AUTHENTICATION (shared by FastAPI and the Baileys engine)
# ---------------------------------------------------------------

# API key required on every request, either via the "X-API-Key"
# header or the "apikey" query parameter.
# CHANGE THIS to a long random string, e.g. generated with:
#     openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# OPTIONAL: if set, requests may also authenticate with
# "Authorization: Bearer <jwt>" (HS256). Issued by your own tooling.
# Leave empty to disable JWT auth.
JWT_SECRET=

# ---------------------------------------------------------------
# WEBHOOKS  (outgoing events, delivered to your application)
# ---------------------------------------------------------------

# Global webhook URL. The Baileys engine POSTs events to this URL.
# Leave empty to disable webhooks.
WEBHOOK_URL=

# Comma-separated list of events to deliver:
#   message, message.sent, message.delivered, message.read,
#   connection.open, connection.close, qr, logout
WEBHOOK_EVENTS=message,message.sent,message.delivered,message.read,connection.open,connection.close,qr,logout

# How many times to retry a failed webhook delivery (exponential backoff).
WEBHOOK_RETRIES=5

# OPTIONAL: sign webhook payloads with an HMAC-SHA256 signature, sent in
# the "X-Webhook-Signature" header. Your receiver verifies it to guarantee
# the payload really came from this instance. Empty = no signature.
WEBHOOK_SECRET=

# OPTIONAL: download incoming media and include it as base64 in "message"
# webhooks (mediaBase64). Media can be large, so this is OFF by default.
WEBHOOK_MEDIA=false
# Skip embedding base64 for media larger than this (bytes). Default: 10 MB.
WEBHOOK_MEDIA_MAX_BYTES=10485760

# Per-session webhook override (optional): set WEBHOOK_URL_<SESSIONNAME>
# to route a specific session's events to a different URL.
# Example:  WEBHOOK_URL_MYSHOP=https://erp.example.com/hooks/whatsapp

# ---------------------------------------------------------------
# BAILEYS ENGINE (WhatsApp)
# ---------------------------------------------------------------

# Internal address of the Baileys container (used by FastAPI only).
BAILEYS_URL=http://baileys:3000

# Automatically create a session on first use (POST /send-*).
# When false, the session must be created explicitly first.
AUTO_CREATE_SESSION=true

# Delay in ms between two outgoing messages (0 = disabled).
# Default 2000 ms: a short gap between sends keeps automated traffic under
# WhatsApp's anti-spam radar - bursts can trigger temporary throttling.
SEND_DELAY_MS=2000

# Reconnect delay in ms after an unexpected disconnection.
RECONNECT_DELAY_MS=5000

# Maximum number of concurrent WhatsApp sessions.
MAX_SESSIONS=10

# Print the QR code in the container logs (docker logs wapi-baileys).
PRINT_QR_IN_TERMINAL=true

# Log level for the engine: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Browser descriptor reported to WhatsApp.
BROWSER_PLATFORM=Chrome
BROWSER_NAME=WAPI
BROWSER_VERSION=1.0.0

# ---------------------------------------------------------------
# FASTAPI (REST API)
# ---------------------------------------------------------------

# Comma-separated list of allowed CORS origins, or "*" for all.
CORS_ORIGINS=*

# Rate limit applied to message-sending endpoints ("X per minute|hour|day").
RATE_LIMIT=60/minute
